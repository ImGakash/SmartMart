DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
PG_POOL_MAX=8
PORT=4000
PG_CA_CERT_PATH=ca.pem

KAFKA_BROKERS=host:port
KAFKA_AUTH_MODE=sasl
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=password
KAFKA_CA_CERT_PATH=ca.pem

OPENSEARCH_URL=https://host:port
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=password
OPENSEARCH_CA_CERT_PATH=ca.pem

OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_SECONDS=10
OUTBOX_MAX_ATTEMPTS=5
KAFKA_PUBLISH_TIMEOUT_MS=8000
